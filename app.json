{
  "expo": {
    "name": "spotme",
    "scheme": "spotme",
    "slug": "spotme",
    "version": "1.0.0",
    "description": "Your ultimate fitness companion for tracking workouts and progress.",
    "orientation": "portrait",
    "icon": "./assets/appicn/appicon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.alen899993.spotme"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "themeColor": "#ef4444",
      "manifest": {
        "name": "SpotMe - Fitness Tracker",
        "short_name": "SpotMe",
        "description": "Your ultimate fitness companion for tracking workouts and progress.",
        "start_url": "/",
        "display": "standalone",
        "orientation": "portrait",
        "background_color": "#000000",
        "theme_color": "#ef4444",
        "icons": [
          {
            "src": "favicon.png",
            "sizes": "48x48",
            "type": "image/png"
          },
          {
            "src": "icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
          },
          {
            "src": "icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/75aa2fe6-48c8-46b8-a855-670ba9abce05"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "75aa2fe6-48c8-46b8-a855-670ba9abce05"
      }
    },
    "owner": "alen899993"
  }
}